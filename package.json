{
  "name": "pindou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm run check:deterministic && npm run coverage",
    "check:deterministic": "node scripts/check-no-random.mjs",
    "e2e": "node scripts/e2e.mjs",
    "make:test-image": "node scripts/make-test-image.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jspdf": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
